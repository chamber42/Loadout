# The 1.2MB single-file original, kept locally as a fallback. Deliberately not
# published: a stale copy of the whole app sitting next to the live one is a
# trap, both for visitors and for future edits.
index.original.html

# Transient test harnesses are written into this folder and deleted again.
# Ignored so a crashed run can never commit one by accident.
__*.html

# Per-machine Claude Code permissions. Local settings, not project settings —
# committing them would push one machine's allowlist onto every clone.
.claude/

# Installed from package-lock.json by `npm install`. Only the native build
# needs them; the web app itself has no dependencies at all.
node_modules/

# Generated by build-www.sh from the tracked sources next to it. Committing
# it would mean every web change lands twice in the diff, once in the real
# file and once in its copy.
www/
